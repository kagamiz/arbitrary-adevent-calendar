# 環境設定
ENVIRONMENT=local

# データベース設定
DATABASE_URL=sqlite:///./advent_calendar.db

# セキュリティ設定
SECRET_KEY=your-secret-key-here-change-this-in-production

# X (Twitter) OAuth設定
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
X_REDIRECT_URI=https://jb-advcal2025-17th-anniv.miz-miz.biz/api/auth/callback
X_BEARER_TOKEN=your-x-bearer-token

# フロントエンドURL設定
FRONTEND_URL=https://jb-advcal2025-17th-anniv.miz-miz.biz

# カレンダー設定
CALENDAR_NAME="jubeat Advent Calendar 2025 -17th Anniversary-"
CALENDAR_START_DATE=2025-06-25
CALENDAR_END_DATE=2025-07-24

# 管理者ユーザー設定（カンマ区切りのユーザー名を指定）
ADMIN_USERNAMES=admin1,admin2

# フロントエンド設定
VITE_API_BASE_URL=https://jb-advcal2025-17th-anniv.miz-miz.biz 
VITE_CALENDAR_NAME="jubeat Advent Calendar 2025 -17th Anniversary-"
